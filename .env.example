# CampusPal configuration — fill in the values, then restart `npx expo start`.
# These values are designed to be shipped inside the app; they are NOT secrets.
# Never put your Cloudinary API Key / API Secret here.

# Firebase console → Project settings → General → Your apps → Web app → firebaseConfig
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary dashboard → Cloud name, and Settings → Upload → your *unsigned* preset name
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Only emails ending with this domain can sign up
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=unigoa.ac.in
